# Python caches and local environments
__pycache__/
.pytest_cache/
# Virtual environments
.venv/
venv/
dist/
*.pyc
*.pyo
.tox/
.nox/
.hypothesis/
*.egg-info/
build/

# Generated outputs belong outside the source tree.
/src/artifacts/
/artifacts/annotated_images/
/artifacts/converted_images/commented_diff_images/
/artifacts/converted_images/converted_images_png/
/artifacts/converted_images/converted_images_png_failed/
# New batch products stay local. Previously committed regression evidence is
# retained; ignore rules do not remove existing fixtures from Git.
/artifacts/converted_images/*
/artifacts/pytest/
/artifacts/evaluation/**/commented_diff_images/
/artifacts/evaluation/**/converted_images_png/
/artifacts/evaluation/**/converted_images_png_failed/
/artifacts/evaluation/**/diff_pngs/
/artifacts/evaluation/**/archive_previous_cli_svgs/
/artifacts/evaluation/**/archive_reconverted_svgs/
/artifacts/evaluation/**/archive_outputs/
/tests.txt

# Profiling artifacts
artifacts/perf/**/*.prof
/.venv-py314

# Local analysis and runtime output
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.prof
*.tmp
*.local.log

# Generated conversion search runs (including long hashed filenames)
/artifacts/evaluation/conversion_search_*/

# Reproducibly generated semantic-only benchmark rasters
/artifacts/semantic_only_png_benchmark/

# Disposable local test data and Plan-B acceptance runs (CI uploads artifacts)
/.tmp/

# Default for EVERY evaluation, including newly named studies: only compact
# review/replay metadata is added to Git. Raw CLI trees, rasters, vectors and
# logs remain disposable, without needing another rule for each experiment.
/artifacts/evaluation/*/*
!/artifacts/evaluation/*/README.md
!/artifacts/evaluation/*/.gitignore
!/artifacts/evaluation/*/summary.json
!/artifacts/evaluation/*/checks.json
!/artifacts/evaluation/*/generation.json
!/artifacts/evaluation/*/manifest.json

# Full cleanup inventories are temporary review aids; keep seed journals instead.
/config/cleanup_*inventory.json

# Generated scene-fusion evidence stays local; version only compact results.
/artifacts/evaluation/visibility_scene_v1/*
!/artifacts/evaluation/visibility_scene_v1/README.md
!/artifacts/evaluation/visibility_scene_v1/summary.json
!/artifacts/evaluation/visibility_scene_v1/checks.json
/artifacts/evaluation/fused_scene_v1/*
!/artifacts/evaluation/fused_scene_v1/README.md
!/artifacts/evaluation/fused_scene_v1/summary.json
!/artifacts/evaluation/fused_scene_v1/checks.json
/artifacts/evaluation/plan_b_variations/
/artifacts/evaluation/plan_b_random_*/
/artifacts/plan-b-acceptance/

# Keep recheck inputs and compact evidence; generated vectors/reports stay local.
/artifacts/evaluation/downward_gradient_arrow_recheck_v1/*
!/artifacts/evaluation/downward_gradient_arrow_recheck_v1/manifest.json
!/artifacts/evaluation/downward_gradient_arrow_recheck_v1/summary_2026-10-07.json

/artifacts/evaluation/chevron_panel_recheck_v1/*
!/artifacts/evaluation/chevron_panel_recheck_v1/manifest.json
!/artifacts/evaluation/chevron_panel_recheck_v1/summary_2026-10-08.json
/artifacts/evaluation/three_way_valve_recheck_v1/*
!/artifacts/evaluation/three_way_valve_recheck_v1/summary_2026-10-08.json

/artifacts/evaluation/checkbox_checkmark_recheck_v1/*
!/artifacts/evaluation/checkbox_checkmark_recheck_v1/manifest.json
!/artifacts/evaluation/checkbox_checkmark_recheck_v1/summary_2026-10-08.json

# Component studies: commit compact evidence; keep generated runs locally or in CI artifacts.
/artifacts/evaluation/component_value_v*/*
!/artifacts/evaluation/component_value_v*/README.md
!/artifacts/evaluation/component_value_v*/summary.json
!/artifacts/evaluation/component_value_v*/checks.json
!/artifacts/evaluation/component_value_v*/manifest.json
/artifacts/evaluation/component_retention_v*/*
!/artifacts/evaluation/component_retention_v*/README.md
!/artifacts/evaluation/component_retention_v*/summary.json
!/artifacts/evaluation/component_retention_v*/checks.json
!/artifacts/evaluation/component_retention_v*/manifest.json
/artifacts/evaluation/component_*probe_v*/
/artifacts/evaluation/component_control_render_delay_v*/

# Optional neural experiment: retain compact results/models, upload raw runs in CI.
/artifacts/evaluation/neural_elements_v*/*
!/artifacts/evaluation/neural_elements_v*/README.md
!/artifacts/evaluation/neural_elements_v*/summary.json
!/artifacts/evaluation/neural_elements_v*/checks.json
!/artifacts/evaluation/neural_elements_v*/manifest.json
!/artifacts/evaluation/neural_elements_v*/models/

# Real-region experiments retain annotations, inventory and compact evidence.
/artifacts/evaluation/neural_real_regions_v*/*
!/artifacts/evaluation/neural_real_regions_v*/README.md
!/artifacts/evaluation/neural_real_regions_v*/manifest.json
!/artifacts/evaluation/neural_real_regions_v*/summary.json
!/artifacts/evaluation/neural_real_regions_v*/checks.json
!/artifacts/evaluation/neural_real_regions_v*/region_audit.json
!/artifacts/evaluation/neural_real_regions_v*/models/
