      "reported_per_split": [
        "development",
        "holdout"
      ]
    },
    "edge": {
      "required": true,
      "metrics": [
        "edge_iou",
        "chamfer_distance_px",
        "edge_recall"
      ],
      "reported_per_split": [
        "development",
        "holdout"
      ]
    },
    "structure": {
      "required": true,
      "metrics": [
        "primitive_count_delta",
        "bbox_iou",
        "path_complexity_ratio"
      ],
      "reported_per_split": [
        "development",
        "holdout"
      ]
    },
    "semantic": {
      "required": true,
      "metrics": [
        "constraint_precision",
        "constraint_recall",
        "semantic_status"
      ],
      "reported_per_split": [
        "development",
        "holdout"
      ]
    }
  },
  "required_split_reports": {
    "development": {
      "pixel": {
        "required": true
      },
      "edge": {
        "required": true
      },
      "structure": {
        "required": true
      },
      "semantic": {
        "required": true
      }
    },
    "holdout": {
      "pixel": {
        "required": true
      },
      "edge": {
        "required": true
      },
      "structure": {
        "required": true
      },
      "semantic": {
        "required": true
      }
    }
  },
