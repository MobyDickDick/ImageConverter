Beispiele:
  python -m src.imageCompositeConverter artifacts/images_to_convert --descriptions-path artifacts/images_to_convert/Finale_Wurzelformen_V3.xml --output-dir artifacts/converted_images --start FIRST --end LAST
  python -m src.imageCompositeConverter artifacts/images_to_convert --mode annotate --output-dir artifacts/annotated --start SAMPLE_A --end SAMPLE_B
  python -m src.imageCompositeConverter --print-linux-vendor-command --vendor-dir vendor
