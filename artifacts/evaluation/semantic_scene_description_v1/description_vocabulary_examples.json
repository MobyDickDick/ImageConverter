        "schema_version": "semantic_scene_description_v1",
        "description_id": "synthetic_left_circle_connector",
        "source_text": "Kreis mit Linie links am Kreis, ohne Beschriftung",
        "language": "de",
        "canvas": { "width": 100, "height": 100, "units": "relative" },
        "objects": [
          { "id": "main_circle", "type": "circle", "role": "primary_shape", "colors": [{ "name": "black", "role": "stroke", "confidence": 0.8 }], "confidence": 1.0, "evidence": ["description"] },
          { "id": "left_connector", "type": "line", "role": "connector", "directions": ["left", "horizontal"], "confidence": 0.95, "evidence": ["description"] }
        ],
        "relations": [
          { "subject": "left_connector", "predicate": "attached_to", "object": "main_circle", "direction": "left", "confidence": 0.95, "evidence": ["description"] }
        ],
        "constraints": [
          { "kind": "hard", "rule": "primitive_required", "targets": ["main_circle"], "params": { "type": "circle" }, "weight": 1.0 },
          { "kind": "soft", "rule": "direction_hint", "targets": ["left_connector"], "params": { "direction": "left" }, "weight": 0.8 }
        ],
        "negations": [
          { "rule": "without_label", "targets": ["main_circle"], "confidence": 0.9, "evidence": ["description"] }
        ]
      }
    },
    {
      "family": "labeled_badge",
      "description": {
        "schema_version": "semantic_scene_description_v1",
        "description_id": "synthetic_co2_badge",
        "source_text": "Text CO₂ im Kreis",
        "language": "de",
        "canvas": { "width": 100, "height": 100, "units": "relative" },
        "objects": [
          { "id": "badge_ring", "type": "ring", "role": "outline", "confidence": 1.0, "evidence": ["description"] },
          { "id": "co2_label", "type": "text", "role": "label", "text": "CO₂", "colors": [{ "name": "black", "role": "text", "confidence": 0.8 }], "confidence": 1.0, "evidence": ["description"] }
        ],
        "relations": [
          { "subject": "co2_label", "predicate": "centered_in", "object": "badge_ring", "confidence": 0.9, "evidence": ["description"] }
        ],
        "constraints": [
          { "kind": "hard", "rule": "text_content", "targets": ["co2_label"], "params": { "text": "CO₂" }, "weight": 1.0 }
        ],
        "negations": []
      }
    },
    {
      "family": "occluded_polygon_arrow",
      "description": {
        "schema_version": "semantic_scene_description_v1",
        "description_id": "synthetic_occluded_polygon_arrow",
        "source_text": "Polygon-Pfeil teilweise hinter Rechteck, roter Füllbereich",
        "language": "de",
        "canvas": { "width": 100, "height": 100, "units": "relative" },
        "objects": [
          { "id": "arrow_shape", "type": "polygon", "role": "primary_shape", "directions": ["right"], "colors": [{ "name": "red", "role": "fill", "confidence": 0.85 }], "confidence": 0.9, "evidence": ["description"] },
          { "id": "cover_rect", "type": "rectangle", "role": "occluder", "confidence": 0.8, "evidence": ["description"] }
        ],
        "relations": [
          { "subject": "arrow_shape", "predicate": "continues_behind", "object": "cover_rect", "confidence": 0.75, "evidence": ["description"] },
          { "subject": "cover_rect", "predicate": "covers", "object": "arrow_shape", "confidence": 0.75, "evidence": ["description"] }
        ],
        "constraints": [
          { "kind": "soft", "rule": "occlusion_order", "targets": ["cover_rect", "arrow_shape"], "params": { "front": "cover_rect", "back": "arrow_shape" }, "weight": 0.7 },
          { "kind": "soft", "rule": "color_hint", "targets": ["arrow_shape"], "params": { "fill": "red" }, "weight": 0.6 }
        ],
        "negations": []
      }
    }
